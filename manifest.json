{
  "manifest_version": 3,
  "name": "Insta-Track",
  "version": "2.0.1",
  "description": "Lists the accounts you follow that do not follow you back. Fully local, resumable, and shows every failure openly.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "unlimitedStorage", "sidePanel", "alarms", "notifications", "power", "tabs"],
  "host_permissions": ["https://www.instagram.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Insta-Track",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["page-fetch.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["instagram-api.js", "mock-api.js", "shared.js", "scan-engine.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
